{
  "manifest_version": 2,
  "name": "WeChat Papers",
  "version": "0.3.0",
  "description": "Find papers in WeChat articles with AI, verify them, import them into Zotero, and find available full text.",
  "author": "Duyang",
  "homepage_url": "https://github.com/nkbaim/zotero-wechat-importer",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-wechat-importer@duyang.dev",
      "update_url": "https://raw.githubusercontent.com/nkbaim/zotero-wechat-importer/main/updates.json",
      "strict_min_version": "8.999",
      "strict_max_version": "10.0.*"
    }
  }
}
